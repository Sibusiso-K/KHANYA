{# Control-room strip: decision, evidence and simulated plant, readable in one glance.
   Inline styles and SVG on purpose: dashboard/static/tailwind.css is compiled
   offline from the classes already in use, so a new utility class would not exist. #}
{% set ok = "#2EA043" %}{% set warn = "#D29922" %}{% set bad = "#F85149" %}{% set dim = "#3A4A57" %}{% set text = "#E6EDF3" %}{% set muted = "#8B9BA8" %}
{% set decision_colour = {"grind": ok, "": ok, "hold": warn}.get(verdict_class, warn) %}
<style>
  .ks-strip{display:grid;grid-template-columns:1.05fr 1fr 1.35fr;gap:20px}
  @media (max-width: 900px){.ks-strip{grid-template-columns:1fr}}
</style>
<section class="ks-strip animate-fade-up">

  <!-- DECISION -->
  <div class="rounded-lg bg-surface border border-outline shadow-elevation-1" style="padding:20px;border-left:6px solid {{ decision_colour }}">
    <div class="font-mono" style="font-size:11px;letter-spacing:.2em;color:{{ muted }};font-weight:700">DECISION</div>
    <div style="font-size:30px;font-weight:700;color:{{ text }};line-height:1.15;margin-top:10px">{{ action_headline }}</div>
    <div class="font-mono" style="font-size:12px;letter-spacing:.14em;color:{{ decision_colour }};font-weight:700;margin-top:10px;text-transform:uppercase">{{ state_label }}</div>
    <div style="font-size:13px;color:{{ muted }};line-height:1.5;margin-top:10px">{{ reason_first_sentence }}</div>
  </div>

  <!-- EVIDENCE -->
  <div class="rounded-lg bg-surface border border-outline shadow-elevation-1" style="padding:20px">
    <div class="font-mono" style="font-size:11px;letter-spacing:.2em;color:{{ muted }};font-weight:700">EVIDENCE</div>
    {% set enough = n_payload_particles is not none and n_payload_particles >= min_payload_particles %}
    <div style="display:flex;align-items:baseline;gap:8px;margin-top:10px">
      <span class="font-mono" style="font-size:34px;font-weight:700;color:{{ ok if enough else bad }}">{{ n_payload_particles if n_payload_particles is not none else "?" }}</span>
      <span style="font-size:13px;color:{{ muted }}">payload-bearing particles · provisional floor {{ min_payload_particles }}</span>
    </div>
    <div style="font-size:12px;color:{{ muted }};margin-top:2px">{{ evidence_scope }}</div>
    {% if lighting and lighting.off %}
    <div style="margin-top:14px;padding:8px 10px;border:1px solid {{ bad }};border-radius:4px">
      <div class="font-mono" style="font-size:12px;font-weight:700;letter-spacing:.12em;color:{{ bad }}">LIGHTING CHECK OFF</div>
      <div style="font-size:11px;color:{{ muted }};line-height:1.35">the confidence gate still applies; this advice was not tested against a simulated lighting change</div>
    </div>
    {% elif lighting %}
    {% set lc = ok if lighting.stable else (muted if lighting.abstained else bad) %}
    <div style="margin-top:14px;display:flex;gap:10px;align-items:center">
      <img src="data:image/png;base64,{{ lighting.as_imaged_b64 }}" alt="fields as imaged" style="width:64px;height:auto;border:1px solid {{ dim }};border-radius:4px">
      {% if lighting.shifted_b64 %}
      <span style="color:{{ muted }};font-size:18px">→</span>
      <img src="data:image/png;base64,{{ lighting.shifted_b64 }}" alt="simulated darker copy (fixed RGB offset)" style="width:64px;height:auto;border:1px solid {{ dim }};border-radius:4px">
      {% endif %}
      <div>
        <div class="font-mono" style="font-size:12px;font-weight:700;letter-spacing:.12em;color:{{ lc }}">SIMULATED LIGHTING: {{ "STABLE" if lighting.stable else ("N/A" if lighting.abstained else "UNSTABLE") }}</div>
        <div style="font-size:11px;color:{{ muted }};line-height:1.35">darker copy (RGB offset): {{ lighting.after_shift }}</div>
      </div>
    </div>
    {% elif advisory_only %}
    <div style="margin-top:14px;padding:8px 10px;border:1px solid {{ warn }};border-radius:4px">
      <div class="font-mono" style="font-size:12px;font-weight:700;letter-spacing:.12em;color:{{ warn }}">ADVISORY ONLY · NO LIGHTING CHECK</div>
      <div style="font-size:11px;color:{{ muted }};line-height:1.35">the lighting check runs only in live sampled-fields mode, so this path issues no plant command</div>
    </div>
    {% else %}
    <div style="margin-top:14px;font-size:11px;color:{{ muted }}">Lighting check runs in live sampled-fields mode.</div>
    {% endif %}
  </div>

  <!-- PLANT (simulated) -->
  <div class="rounded-lg bg-surface border border-outline shadow-elevation-1" style="padding:20px">
    <div style="display:flex;justify-content:space-between;align-items:center">
      <div class="font-mono" style="font-size:11px;letter-spacing:.2em;color:{{ muted }};font-weight:700">PLANT · SIMULATED CIRCUIT</div>
      {% if plant %}
      {% set pc = {"applied": ok, "unchanged": ok, "held": warn, "refused": bad}.get(plant.state, muted) %}
      <span class="font-mono" style="font-size:12px;font-weight:700;letter-spacing:.12em;color:#00131D;background:{{ pc }};padding:3px 10px;border-radius:4px">{{ plant.state|upper }}</span>
      {% endif %}
    </div>
    {% set on = plant and plant.after >= 0.5 %}
    <svg viewBox="0 0 400 120" style="width:100%;height:auto;margin-top:8px" role="img" aria-label="Simulated flotation circuit; regrind {{ 'enabled' if on else 'bypassed' }}">
      <defs><marker id="ah" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 z" fill="{{ muted }}"/></marker></defs>
      {% macro unit(x, y, w, label, colour=dim) %}<rect x="{{ x }}" y="{{ y }}" width="{{ w }}" height="26" rx="4" fill="#0B2230" stroke="{{ colour }}" stroke-width="1.5"/><text x="{{ x + w/2 }}" y="{{ y + 17 }}" text-anchor="middle" font-size="10" font-family="monospace" fill="{{ text }}">{{ label }}</text>{% endmacro %}
      {{ unit(4, 20, 44, "FEED") }}{{ unit(66, 20, 44, "MILL") }}{{ unit(128, 20, 66, "ROUGHER") }}{{ unit(318, 20, 78, "CLEANER") }}
      {{ unit(222, 78, 74, "REGRIND", ok if on else dim) }}
      <line x1="48" y1="33" x2="64" y2="33" stroke="{{ muted }}" stroke-width="1.5" marker-end="url(#ah)"/>
      <line x1="110" y1="33" x2="126" y2="33" stroke="{{ muted }}" stroke-width="1.5" marker-end="url(#ah)"/>
      <!-- bypass: rougher concentrate straight to cleaner -->
      <line x1="194" y1="33" x2="316" y2="33" stroke="{{ dim if on else ok }}" stroke-width="{{ 1.5 if on else 3 }}" {% if on %}stroke-dasharray="4 4"{% endif %} marker-end="url(#ah)"/>
      <text x="255" y="26" text-anchor="middle" font-size="9" font-family="monospace" fill="{{ muted }}">bypass</text>
      <!-- regrind loop -->
      <polyline points="200,33 200,91 220,91" fill="none" stroke="{{ ok if on else dim }}" stroke-width="{{ 3 if on else 1.5 }}" {% if not on %}stroke-dasharray="4 4"{% endif %} marker-end="url(#ah)"/>
      <polyline points="296,91 340,91 340,48" fill="none" stroke="{{ ok if on else dim }}" stroke-width="{{ 3 if on else 1.5 }}" {% if not on %}stroke-dasharray="4 4"{% endif %} marker-end="url(#ah)"/>
      <text x="4" y="112" font-size="9" font-family="monospace" fill="{{ muted }}">regrind_enabled = {{ "%g"|format(plant.after) if plant else "–" }} · illustrative tag over local OPC UA · no plant connected</text>
    </svg>
    {% if plant %}
    <div style="font-size:12px;color:{{ muted }};margin-top:6px;line-height:1.4"><span class="font-mono" style="color:{{ text }}">{{ "%g"|format(plant.before) }} → {{ "%g"|format(plant.after) }}</span> · {{ plant.reason }}</div>
    {% endif %}
  </div>
</section>
