<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<style>
@font-face{font-family:Plus;src:url(data:font/ttf;base64,{{ font_sans_b64 }}) format('truetype');font-weight:300 700}
@font-face{font-family:Jet;src:url(data:font/ttf;base64,{{ font_mono_regular_b64 }}) format('truetype')}
@font-face{font-family:Jet;src:url(data:font/ttf;base64,{{ font_mono_bold_b64 }}) format('truetype');font-weight:700}
*{box-sizing:border-box}html,body{margin:0;background:#f4f6f8;color:#1c2934;font-family:Plus,'Segoe UI',sans-serif}body{padding:0 18px 20px}.top{height:62px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #d8e0e6;padding:0 8px;gap:12px}.brand{display:flex;align-items:center;gap:11px;font-weight:700;letter-spacing:.035em}.mark{width:30px;height:30px;border-radius:8px;background:#133e48;color:#fff;display:grid;place-items:center;font-weight:800}.brand small{display:block;font-size:11px;color:#677580;font-weight:500;letter-spacing:0}.topright{display:flex;align-items:center;gap:14px;color:#53616d;font-size:12px}.badge{padding:6px 9px;border:1px solid #d6dee5;border-radius:20px;background:#fff;font:700 10px Jet,monospace;letter-spacing:.04em}.badge.warn{background:#fff6e7;border-color:#f0d39a;color:#805c14}.intro{display:flex;justify-content:space-between;align-items:end;padding:20px 2px 14px;gap:14px}.eyebrow{font:700 10px Jet,monospace;letter-spacing:.11em;color:#52727b;text-transform:uppercase}.intro h1{font-size:21px;line-height:1.2;margin:5px 0 4px;letter-spacing:-.02em}.intro p{font-size:12px;margin:0;color:#66737e}.status{font:600 10px Jet,monospace;color:#52727b}.cols{display:grid;grid-template-columns: minmax(218px,.92fr) minmax(340px,1.54fr) minmax(218px,.92fr);gap:12px;align-items:stretch}.card{background:#fff;border:1px solid #dbe2e8;border-radius:10px;box-shadow:0 2px 8px #1732490b;overflow:hidden;min-width:0}.head{padding:12px 14px;border-bottom:1px solid #e6ebef;display:flex;align-items:center;justify-content:space-between;gap:8px}.head strong{font-size:12px}.head span{font:10px Jet,monospace;color:#71808b}.pad{padding:13px}.timeline{display:flex;flex-direction:column;gap:8px}.row{display:grid;grid-template-columns:25px 1fr auto;align-items:center;gap:8px;padding:10px;border:1px solid #e7ebef;border-radius:8px;background:#fff}.dot{width:9px;height:9px;border-radius:50%;background:#3e917f;box-shadow:0 0 0 4px #e9f4f0}.row b{font-size:11px}.row small{display:block;color:#71808b;font-size:10px;margin-top:3px}.tag{font:9px Jet,monospace;color:#60707d}.drop{margin-top:10px;background:#f8fafb;border:1px dashed #bac8d1;border-radius:8px;padding:12px;text-align:center;color:#52616d;font-size:11px}.drop b{display:block;color:#20313d;margin-bottom:3px}.spatial{height:220px;position:relative;background:linear-gradient(180deg,#f5f8f8,#edf2f0);overflow:hidden}.terrain{position:absolute;inset:20px 14px 38px;background:linear-gradient(158deg,transparent 23%,#dbe5dc 23.5%,#dbe5dc 36%,#c9d9d1 36.5%,#c9d9d1 52%,#e2e9e1 52.5%,#e2e9e1 100%);clip-path:polygon(0 52%,18% 33%,33% 41%,51% 12%,68% 30%,84% 18%,100% 39%,100% 100%,0 100%);border-bottom:1px solid #bac9c1}.contour{position:absolute;left:0;right:0;height:1px;background:#9eafa4;opacity:.6;transform:rotate(-9deg)}.contour.a{top:90px}.contour.b{top:121px}.contour.c{top:153px}.hole{position:absolute;top:36px;bottom:14px;width:3px;border-radius:3px;background:linear-gradient(#577e6b 0 20%,#e69c4a 20% 46%,#82a89b 46% 69%,#6c8994 69%);box-shadow:0 0 0 3px #ffffffa8}.hole.h1{left:28%}.hole.h2{left:57%}.hole.h3{left:79%}.pin{position:absolute;top:35px;left:53%;padding:5px 8px;border-radius:5px;background:#fff;border:1px solid #ccd8d0;font:9px Jet,monospace;color:#52616d}.spatial-label{position:absolute;left:13px;bottom:9px;background:#fffffff0;border:1px solid #dce3e4;border-radius:6px;padding:7px 9px;color:#566770;font-size:9px}.spatial-note{padding:10px 13px;color:#53626c;font-size:10px;line-height:1.45}.phase-list{display:flex;flex-direction:column;gap:8px}.phase{display:grid;grid-template-columns:9px 1fr auto;gap:8px;align-items:center;font-size:10px}.sw{width:8px;height:8px;border-radius:3px;background:#d66d39}.bar{height:5px;border-radius:5px;background:#e7ecee;margin-top:4px;overflow:hidden}.bar i{display:block;height:100%;background:#d66d39;width:42%;border-radius:5px}.phase:nth-child(2) .sw,.phase:nth-child(2) .bar i{background:#28a196}.phase:nth-child(3) .sw,.phase:nth-child(3) .bar i{background:#9074c3}.phase:nth-child(4) .sw,.phase:nth-child(4) .bar i{background:#d7aa36}.muted{color:#788691}.notice{margin-top:12px;padding:10px;border-radius:7px;background:#fff8e9;border:1px solid #efdfa9;color:#745b20;font-size:10px;line-height:1.4}.bottom{display:grid;grid-template-columns:1.2fr .8fr;gap:12px;margin-top:12px}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.metric{background:#f7f9fa;border:1px solid #e4e9ed;border-radius:8px;padding:10px}.metric b{display:block;font:700 18px Jet,monospace;color:#24445a}.metric small{display:block;margin-top:4px;font-size:9px;color:#6d7b86;line-height:1.3}.workflow{display:flex;align-items:center;justify-content:space-between;gap:6px;padding:13px;color:#64727c;font-size:10px}.step{flex:1;padding:9px 8px;border:1px solid #e0e7ea;border-radius:7px;background:#fafbfc;line-height:1.4}.step b{display:block;color:#263b48;font-size:10px;margin-bottom:3px}.arrow{color:#91a1a9}.foot{padding:11px 2px 0;color:#78858e;font:9px Jet,monospace;display:flex;justify-content:space-between;gap:8px}.alert{margin:12px 0 0;padding:10px;border:1px solid #ecc5c0;background:#fff4f2;border-radius:7px;color:#8c3328;font-size:11px}
@media(max-width:920px){body{padding:0 12px 16px}.cols{grid-template-columns:1fr 1.5fr}.cols .right{grid-column:1/-1}.bottom{grid-template-columns:1fr}.spatial{height:190px}}
@media(max-width:620px){.top{height:auto;padding:12px 2px;align-items:flex-start}.topright{flex-direction:column;align-items:flex-end;gap:5px}.intro{align-items:flex-start;flex-direction:column}.intro h1{font-size:19px}.cols{grid-template-columns:1fr}.cols .right{grid-column:auto}.spatial{height:180px}.metrics{grid-template-columns:1fr 1fr}.workflow{align-items:stretch;flex-direction:column}.arrow{transform:rotate(90deg);align-self:center}.foot{flex-direction:column}}
</style>
</head>
<body>
<header class="top"><div class="brand"><div class="mark">R</div><div>REEFPRINT <span style="color:#89959c">/</span> KHANYA<small>Mineral phase characterisation · research prototype</small></div></div><div class="topright"><span class="badge">{{ subset_label }}</span><span class="badge warn">RESEARCH MODE · NO LIVE PLANT</span></div></header>
<section class="intro"><div><div class="eyebrow">Ore intelligence workbench</div><h1>{{ 'Analysis unavailable' if refusal_reason else 'From polished section to process insight' }}</h1><p>Upload a reflected-light micrograph to run the real segmentation model and inspect its measured output.</p></div><div class="status">● LOCAL INFERENCE · DEVICE DATA STAYS HERE</div></section>
{% if refusal_reason %}<div class="alert" role="alert">{{ refusal_reason }} · No recommendation has been issued.</div>{% endif %}
<section class="cols" aria-label="REEFPRINT mineral analysis workspace">
 <article class="card"><div class="head"><strong>Sample &amp; interval</strong><span>INPUT</span></div><div class="pad"><div class="timeline"><div class="row"><span class="dot"></span><div><b>Upload a polished section</b><small>Reflected-light micrograph · JPG, PNG or TIFF</small></div><span class="tag">READY</span></div><div class="row"><span class="dot" style="background:#7a91a1;box-shadow:0 0 0 4px #edf1f4"></span><div><b>Sample metadata</b><small>Hole, depth, site and coordinates</small></div><span class="tag">OPTIONAL</span></div><div class="row"><span class="dot" style="background:#d3a746;box-shadow:0 0 0 4px #f8f2e3"></span><div><b>Field XRF context</b><small>Element readings can be linked later</small></div><span class="tag">NOT CONNECTED</span></div></div><div class="drop"><b>Use the upload control below</b>Model runs on the original image; no report screenshots or prediction masks.</div></div></article>
 <article class="card"><div class="head"><strong>Geology &amp; spatial context</strong><span>SCHEMATIC · NO SURVEY LOADED</span></div><div class="spatial" role="img" aria-label="Illustrative geology schematic, not actual survey data"><div class="terrain"></div><i class="contour a"></i><i class="contour b"></i><i class="contour c"></i><i class="hole h1"></i><i class="hole h2"></i><i class="hole h3"></i><span class="pin">Hole / depth metadata needed</span><span class="spatial-label">Illustrative geology panel · requires georeferenced collars + intervals</span></div><div class="spatial-note">A real 3D model needs collar coordinates, downhole surveys and logged intervals. The demo will not invent a deposit model from one microscope image.</div></article>
 <article class="card right"><div class="head"><strong>AI phase analysis</strong><span>MODEL STATUS</span></div><div class="pad"><div class="phase-list"><div class="phase"><i class="sw"></i><div>Chalcopyrite<div class="bar"><i></i></div></div><span class="muted">image-derived</span></div><div class="phase"><i class="sw"></i><div>Pyrrhotite<div class="bar"><i></i></div></div><span class="muted">image-derived</span></div><div class="phase"><i class="sw"></i><div>Pentlandite<div class="bar"><i></i></div></div><span class="muted">image-derived</span></div><div class="phase"><i class="sw"></i><div>Magnetite<div class="bar"><i></i></div></div><span class="muted">image-derived</span></div></div><div class="notice"><b>Evidence first.</b> Percentages and masks appear only after inference. Latest Kaggle checkpoint · S2 benchmark only. The separate 0.5725 baseline report is a different checkpoint; compare reports before choosing a model.</div></div></article>
</section>
<section class="bottom"><article class="card"><div class="head"><strong>Validation evidence</strong><span>LATEST KAGGLE RUN · 12 HELD-OUT SECTIONS</span></div><div class="pad"><div class="metrics"><div class="metric"><b>0.4543</b><small>mean IoU · five classes</small></div><div class="metric"><b>0.7716</b><small>pixel accuracy · not mineral accuracy</small></div><div class="metric"><b>3 / 4</b><small>ore phases detected; magnetite IoU = 0.000</small></div></div></div></article><article class="card"><div class="head"><strong>Prediction to plant decision</strong><span>SIMULATION ONLY</span></div><div class="workflow"><div class="step"><b>1 · Model</b>Phase mask + uncertainty</div><span class="arrow">→</span><div class="step"><b>2 · Advisory</b>Human review + reason</div><span class="arrow">→</span><div class="step"><b>3 · Simulator</b>Local OPC UA tag; no PLC</div></div></article></section>
<footer class="foot"><span>Open analysis controls below · Live results show source image, segmentation, metrics and advisory.</span><span>NO XRF DEVICE · NO 3D SURVEY · NO LIVE PLANT CONTROL</span></footer>
</body></html>