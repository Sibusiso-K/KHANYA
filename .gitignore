# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Run logs. Were listed one filename at a time until 2026-09-03; a pattern
# does the same job and stops the list drifting behind the code.
logs/
*.log

# Data. Never committed raw - see DATA-SOURCES.md for provenance and how to
# re-fetch each archive.
data/raw/
data/processed/
data/derived/

# Model weights. Large, regenerable from the training scripts.
checkpoints/

# Generated report artefacts, except the figures actually cited in the report.
reports/*.png
!reports/figures/
!reports/figures/*.png
reports/*.csv

# Claude Code machine-local settings (permissions, not project config)
.claude/settings.local.json
# Responsive workbench (private runtime artefacts)
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
.workbench/
.runtime_packages/
