!data/**/*.dvc
!data/**/.gitignore

# --- acquisition output: large, regenerable, provenance lives in the OME-XML header ---
*.ome.tif
*.ome.tiff
captures/
experiments/**/output/
experiments/**/figures/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# --- secrets: nothing in this project should need one, which is the point ---
.env
.env.*
!.env.example
*.key
*.pem

# --- session scratch ---
.remember/
