# One canonical line ending in the repo regardless of checkout platform, so
# every commit stops emitting "LF will be replaced by CRLF" noise.
* text=auto eol=lf
*.png binary
*.jpg binary
*.zip binary

# Downloaded, SHA-256-bound evaluation CSVs retain the publisher run's exact
# bytes (including CRLF) across Linux CI and Windows checkout.
/reports/native-selected-test-20261001/*.csv -text

# Preserve the pre-submission notebook serialization for its recorded byte hash.
/training/native-selected-test-20261001/evaluation.ipynb -text
